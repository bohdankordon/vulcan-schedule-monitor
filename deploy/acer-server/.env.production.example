# Production configuration template for acer-server.
# Copy to /opt/vulcan-schedule-monitor/.env.production on acer-server (root:root, 0600).
# Never commit real passwords, tokens, or master keys to source control.

# Canonical Compose project identity (matches backup/restore tooling and systemd units):
COMPOSE_PROJECT_NAME=vulcan-schedule-monitor-prod

# Required unique secrets (generate random credentials before first startup):
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
# Generate with: openssl rand -base64 32
VULCAN_MASTER_KEY=

# Public edge port binding on acer-server (router forwards TCP 80/443 to host 80/443):
EDGE_BIND_ADDRESS=0.0.0.0
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# Public domain name for Caddy automatic HTTPS:
CADDY_SITE_ADDRESS=vulcan-schedule-monitor.dns-dns.com

# Canonical public base URL for connect links and callbacks:
PUBLIC_BASE_URL=https://vulcan-schedule-monitor.dns-dns.com

# Initial deployment switches: keep providers OFF until stack health is proven:
VULCAN_CONNECTION_ENABLED=false
VULCAN_MONITORING_ENABLED=false
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# Real container memory limits are enforced in compose.production.yml:
# - app: 2g hard limit
# - postgres: 1g hard limit
# - caddy: 512m hard limit
# (Total container ceiling = 3.5 GiB, leaving >=1.7 GiB for host OS and network on acer-server).
#
# Inside the 2g app container, Java heap is capped at 50% (1.0 GiB max, 400 MiB initial),
# leaving 1.0 GiB of container headroom for Playwright Chromium, Node driver, and native threads:
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=20.0 -XX:MaxRAMPercentage=50.0 -XX:+ExitOnOutOfMemoryError
