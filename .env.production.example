# Copy to .env.production (untracked). Supply unique secrets before starting.
# These deliberately empty values cause Compose to fail until supplied.
# Cluster bootstrap/administration only; never supplied to Spring/Flyway.
POSTGRES_ADMIN_PASSWORD=
# Non-superuser application/Flyway credential; use a different random password.
POSTGRES_APP_PASSWORD=
# Base64 encoding of exactly 32 random bytes. Keep stable with the database.
VULCAN_MASTER_KEY=

EDGE_BIND_ADDRESS=127.0.0.1
EDGE_HTTP_PORT=8080
EDGE_HTTPS_PORT=8443
# Hostname only, without scheme or port. Container listeners stay 8080/8443.
CADDY_SITE_ADDRESS=localhost
# Configured external HTTPS origin for connect links; never derived from headers.
PUBLIC_BASE_URL=
VULCAN_CONNECTION_ENABLED=false
VULCAN_MONITORING_ENABLED=false
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
JAVA_TOOL_OPTIONS=
