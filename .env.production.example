# Copy to .env.production (untracked). Supply unique secrets before starting.
# These deliberately empty values cause Compose to fail until supplied.
POSTGRES_PASSWORD=
# Base64 encoding of exactly 32 random bytes. Keep stable with the database.
VULCAN_MASTER_KEY=

APP_PORT=8080
PUBLIC_BASE_URL=
VULCAN_CONNECTION_ENABLED=false
VULCAN_MONITORING_ENABLED=false
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
JAVA_TOOL_OPTIONS=
